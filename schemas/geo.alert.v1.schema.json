{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodata.example.com/schemas/geo.alert.v1.schema.json",
  "title": "Geotechnical Alert Event",
  "description": "Emitted by the alert engine when a rule fires. Consumed by notification services and UI.",
  "type": "object",
  "required": [
    "schema", "msg_id", "site", "level", "rule_id", "rule_version",
    "t_triggered", "sensors", "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "geo.alert.v1" },
    "msg_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "site": { "$ref": "geo.telemetry.v1.schema.json#/$defs/identifier" },
    "structure": { "$ref": "geo.telemetry.v1.schema.json#/$defs/identifier" },
    "section": { "$ref": "geo.telemetry.v1.schema.json#/$defs/identifier" },
    "level": {
      "type": "string",
      "enum": ["NORMAL", "ATENCAO", "ALERTA", "EMERGENCIA_N1", "EMERGENCIA_N2"]
    },
    "rule_id": { "type": "string", "maxLength": 128 },
    "rule_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "t_triggered": { "$ref": "geo.telemetry.v1.schema.json#/$defs/rfc3339_utc_ms" },
    "t_resolved": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "geo.telemetry.v1.schema.json#/$defs/rfc3339_utc_ms" }
      ]
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "geo.telemetry.v1.schema.json#/$defs/identifier" }
    },
    "evidence": {
      "description": "Snapshot of the inputs that caused the rule to fire. Human-readable + machine-readable.",
      "type": "object",
      "required": ["summary", "samples"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 512 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sensor", "t_sample", "values"],
            "additionalProperties": false,
            "properties": {
              "sensor": { "$ref": "geo.telemetry.v1.schema.json#/$defs/identifier" },
              "t_sample": { "$ref": "geo.telemetry.v1.schema.json#/$defs/rfc3339_utc_ms" },
              "values": { "type": "object" },
              "threshold": { "type": "number" },
              "observed": { "type": "number" }
            }
          }
        }
      }
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email", "sms", "voice", "push", "webhook",
          "teams", "slack", "siren", "increase_sampling",
          "create_incident", "acionar_paebm"
        ]
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ack_user": { "type": "string", "maxLength": 64 },
        "ack_at": { "$ref": "geo.telemetry.v1.schema.json#/$defs/rfc3339_utc_ms" },
        "ack_comment": { "type": "string", "maxLength": 2048 }
      }
    }
  }
}
